# App
NEXT_PUBLIC_URL=https://uficoltd.com
NEXT_PUBLIC_SITE_NAME="United Farmer and Industry Co LTD"

# Database (SQLite local; use Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Auth.js
AUTH_SECRET="generate-a-long-random-string"
# AUTH_URL=http://localhost:3000

# Admin seed (prisma db seed)
ADMIN_EMAIL=sales@uficoltd.com
ADMIN_PASSWORD=ChangeMeNow!UFI

# Resend — required for contact & enquiry forms
# 1. Create a free account at https://resend.com
# 2. Verify uficoltd.com (add DNS records in your domain panel)
# 3. Add RESEND_API_KEY in Vercel → Project → Settings → Environment Variables
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=sales@uficoltd.com
RESEND_FROM_NAME="UFI Co., LTD"
RESEND_TO_EMAIL=sales@uficoltd.com
