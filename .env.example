# App
NEXT_PUBLIC_URL=https://uficoltd.com
NEXT_PUBLIC_SITE_NAME="United Farmer and Industry Co LTD"

# Database — Postgres required (Vercel serverless cannot use SQLite)
# Create Neon (https://neon.tech) or Vercel → Storage → Postgres, then paste the URL:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js (required for /admin on Vercel)
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"
AUTH_URL=https://uficoltd.com

# Admin seed (run once against prod: pnpm db:seed)
ADMIN_EMAIL=sales@uficoltd.com
ADMIN_PASSWORD=ChangeMeNow!UFI

# Resend — required for contact & enquiry forms
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=sales@uficoltd.com
RESEND_FROM_NAME="UFI Co., LTD"
RESEND_TO_EMAIL=sales@uficoltd.com

# Cloudflare Turnstile — existing widget "UFI contact forms"
# Site key is public. Secret must only live in ignored .env / Vercel env.
# Production TURNSTILE_HOSTNAMES must not include localhost.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAE48kXHhXh2i5dWd
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=uficoltd.com,www.uficoltd.com

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
